# ─── api-go · variables de entorno ───────────────────────────────────────────
# Copia este archivo a .env y ajusta los valores. Obligatorias: JWT_SECRET, AUTH_USERNAME, AUTH_PASSWORD.

# Puerto HTTP del servicio
PORT=8080

# URL base de api-node (único punto de acoplamiento, vía HTTP).
#   - api-node corriendo en tu máquina:        http://localhost:3000
#   - api-go en Docker y api-node en tu máquina: http://host.docker.internal:3000
#   - En la nube: la URL pública/interna del servicio api-node
NODE_API_URL=http://localhost:3000
# Timeout (ms) de cada llamada a api-node
NODE_API_TIMEOUT_MS=5000

# JWT (HS256). JWT_SECRET, JWT_ISSUER y JWT_AUDIENCE DEBEN coincidir con los de api-node.
# Genera un secreto con: openssl rand -base64 48   (mínimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-o-mas
JWT_ISSUER=api-go
JWT_AUDIENCE=matrix-services
# Vigencia del token en minutos
JWT_TTL_MINUTES=60

# Usuario de demostración para POST /api/v1/auth/login
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# Orígenes permitidos por CORS (separados por coma), p. ej. el frontend Angular
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Máximo de filas y de columnas aceptado por matriz
MATRIX_MAX_DIMENSION=100
